# --- LLM self-healing ---
# stub = tests / CI (no network, no API key)
LLM_BACKEND=stub

# Gemini (Google AI Studio) — set these to enable real healing:
# LLM_BACKEND=gemini
# LLM_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.0-flash

# Ollama / vLLM (OpenAI-compatible) — local Llama healing:
# LLM_BACKEND=openai_compatible
# # or: LLM_BACKEND=llama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=60

# --- Compliance RAG (Chroma) ---
RAG_ENABLED=true
RAG_TOP_K=2
RAG_PERSIST_DIR=.chroma
RAG_COLLECTION_NAME=compliance
# RAG_POLICY_PATH=  # empty = package default credit_policy_pt.md
# Sentence Window + RRF (Item 2):
RAG_SENTENCE_WINDOW=true
RAG_WINDOW_SENTENCES=2
RAG_WINDOW_OVERLAP=0
RAG_RRF_ENABLED=true
RAG_RRF_K=60
RAG_RRF_CANDIDATES=8

# --- Credit / bureau ---
# BUREAU_CLIENT=stub
# BUREAU_STUB_DEFAULT_SCORE=650
# BUREAU_CLIENT=http
# BUREAU_BASE_URL=http://localhost:9090
# BUREAU_TIMEOUT_SECONDS=3
# CREDIT_EMERGENCY_LIMIT=500
# CREDIT_AUTONOMOUS_LIMIT_CAP=10000

# --- Database ---
# DB_URL=sqlite+aiosqlite:///./data/credit_engine.db
