# --- LLM self-healing ---
# stub = tests / CI (no network, no API key)
LLM_BACKEND=stub

# Gemini (Google AI Studio) — set these to enable real healing:
# LLM_BACKEND=gemini
# LLM_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.0-flash

# --- Compliance RAG (Chroma) ---
RAG_ENABLED=true
RAG_TOP_K=2
RAG_PERSIST_DIR=.chroma
RAG_COLLECTION_NAME=compliance
# RAG_POLICY_PATH=  # empty = package default credit_policy_pt.md

# --- Credit / bureau ---
# BUREAU_CLIENT=stub
# BUREAU_STUB_DEFAULT_SCORE=650
# BUREAU_CLIENT=http
# BUREAU_BASE_URL=http://localhost:9090
# BUREAU_TIMEOUT_SECONDS=3
# CREDIT_EMERGENCY_LIMIT=500
# CREDIT_AUTONOMOUS_LIMIT_CAP=10000

# --- Database ---
# DB_URL=sqlite+aiosqlite:///./data/credit_engine.db
